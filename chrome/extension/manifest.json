{
  "manifest_version": 3,
  "name": "Agent tab notes",
  "version": "1.7.0",
  "description": "Shows on each tab an agent opened: when, which Claude session and project, why, and what you must do now; a comment box to answer it. Keeps each project's agent tabs in that project's window. Formats local Markdown files (file:///….md).",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent tab notes"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.markdown"
      ],
      "js": [
        "marked.js",
        "md_view.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "push.js",
        "note.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

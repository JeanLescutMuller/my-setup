{
  "respondToBashCommands": false,
  "theme": "dark",
  "cleanupPeriodDays": 365,
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "autoMemoryEnabled": false,
  "skillOverrides": {
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "whatsapp-cli:whatsapp": "off"
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "permissions": {
    "deny": [
      "Read(~/Library/Application Support/Google/Chrome/Default/**)",
      "Edit(~/Library/Application Support/Google/Chrome/Default/**)",
      "Bash(*Chrome/Default*)",
      "Bash(*profile-directory=Default*)",
      "Bash(*profile-directory Default*)"
    ]
  },
  "remoteControlAtStartup": true
}
